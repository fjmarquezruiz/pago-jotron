{
    "name": "pago-jotron",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@12.18.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "drizzle-orm": "^0.45.4",
        "mysql2": "^3.24.6",
        "next": "14.2.35",
        "next-auth": "^4.24.15",
        "react": "^18",
        "react-dom": "^18",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "dotenv": "^18.0.9",
        "drizzle-kit": "^0.31.11",
        "eslint": "^8",
        "eslint-config-next": "14.2.35",
        "eslint-config-prettier": "^10.1.8",
        "postcss": "^8",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^3.4.1",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^5.1.0"
    }
}
