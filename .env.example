DATABASE_URL=mysql://jotron:jotron_password@localhost:3306/jotron
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<genera-uno-con-openssl-rand-base64-32>

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<tu-cloud-name>
CLOUDINARY_API_KEY=<tu-api-key>
CLOUDINARY_API_SECRET=<tu-api-secret>
CLOUDINARY_URL=cloudinary://<tu-api-key>:<tu-api-secret>@<tu-cloud-name>

# Stripe (claves de PRUEBA del panel de Stripe: Desarrolladores > Claves de API, modo de prueba)
STRIPE_SECRET_KEY=<sk_test_...>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_test_...>

# Transferencia bancaria: es de MVP2 y está oculta salvo BANK_TRANSFER_ENABLED=true
BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_HOLDER=<titular de la cuenta>
BANK_TRANSFER_IBAN=<IBAN de la cuenta>

# Facturas (RF8): datos fiscales de la tienda, tal como deben salir en la factura (Real Decreto
# 1619/2012). Sin valores por defecto: sin las tres, el PDF de la factura no se puede generar.
# INVOICE_ISSUER_NAME=
# INVOICE_ISSUER_TAX_ID=
# INVOICE_ISSUER_ADDRESS=

# Correo (nodemailer). En local, Mailpit (docker compose up -d mailpit): SMTP en localhost:1025 sin
# credenciales y bandeja en http://localhost:8025. En producción, el SMTP real (A13). Sin SMTP_HOST
# o MAIL_FROM no se envía ningún correo (queda en el log) y los pedidos funcionan igual.
SMTP_HOST=
SMTP_PORT=
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=

# Cron de Vercel (bloqueo de pedidos a los 15 días): Vercel manda `Authorization: Bearer <CRON_SECRET>`.
# Genera uno con `openssl rand -base64 32`. Sin él la ruta responde 500 y no bloquea nada.
CRON_SECRET=
